<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppUsuarios.MainPage">

    <Grid RowDefinitions="*, Auto" Padding="30">

        <!-- Logo HBM -->
        <Image Grid.Row="0"
               Source="logohbm.jpg" 
               WidthRequest="280" 
               HeightRequest="280"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

            <!-- O Botão -->
        <Button Grid.Row="1"
                Text="Carregar usuarios"
                Clicked="AoClicarNoBotaoCarregar"
                BackgroundColor="#007BFF"
                TextColor="White"
                BorderColor="#000000"
                BorderWidth="2"
                CornerRadius="8"
                HeightRequest="55"
                FontSize="18"
                Margin="0, 0, 0, 20" />

    </Grid>

</ContentPage>